# Salin file ini menjadi .env lalu sesuaikan isinya
# (untuk produksi, set nilai-nilai ini di dashboard hosting Anda)

# Port tempat server berjalan
PORT=3000

# Kunci rahasia untuk JWT (GANTI dengan string acak yang kuat!)
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# Cloudinary untuk upload foto (daftar gratis di https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Path database SQLite (untuk production di Railway: /app/data/dragon.db)
DB_PATH=./data/dragon.db
