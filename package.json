{
  "name": "dragon-machine-server",
  "version": "1.0.0",
  "description": "Dragon Machine - Sistem Manajemen Bahan & Reagen (Node.js + Express + SQLite)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i public/css/tailwind.input.css -o public/css/tailwind.css --minify",
    "dev:css": "tailwindcss -i public/css/tailwind.input.css -o public/css/tailwind.css --watch"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  }
}
